# Copy to backend/.env and fill in real values. Never commit the real file.
#
#   cp backend/.env.example backend/.env
#
# Read automatically on startup by spring.config.import in application.yml.
# A real environment variable of the same name overrides whatever is here, so
# production can keep using its own secret store and ignore this file.

# ---- database --------------------------------------------------------------
# The PostgreSQL role the application connects as.
DB_USERNAME=rms
DB_PASSWORD=

# ---- token signing ---------------------------------------------------------
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
# Changing it invalidates every issued token, which signs everybody out.
JWT_SECRET=

# ---- mail ------------------------------------------------------------------
# Sends the password-reset code. Leave blank and the code is written to the
# application log instead, which is enough to develop against.
#
# Gmail will NOT accept your normal account password. Turn on 2-Step
# Verification, then create an App Password:
#   https://myaccount.google.com/apppasswords
# It is 16 letters, shown in four groups — enter it here with the spaces
# removed. Treat it as a password: it can send mail as you until revoked.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
