# ---- secrets --------------------------------------------------------------
# Anything matching these holds a real credential. The patterns are deliberately
# wider than the files that exist today: a secret that is added later should be
# ignored before anyone thinks to update this list, not after.
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
*.local.yml
application-local.yml
application-secret.yml
backend/src/main/resources/application-local.yml
!backend/src/main/resources/application-local.yml.example

# ---- java / gradle --------------------------------------------------------
backend/build/
backend/.gradle/
backend/bin/
backend/out/
*.class
*.jar
# The negation has to match the real path. Anchored at the root it never did,
# so *.jar above swallowed the wrapper and a fresh clone could not build at
# all — which is what the first CI run found.
!**/gradle/wrapper/gradle-wrapper.jar
*.log

# ---- node / next ----------------------------------------------------------
node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/next-env.d.ts
.pnp
.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache

# ---- ide ------------------------------------------------------------------
.idea/
.vscode/
*.iml
*.iws
*.ipr
.classpath
.project
.settings/

# ---- os -------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
